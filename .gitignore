/runs/
*.partial
__pycache__/
.pytest_cache/
.coverage
*.py[cod]
.venv/

# Raw or locally staged third-party data are not redistributed.
/data/external/
/data/processed/*
!/data/processed/README.md

# Runtime provenance may contain local paths and cluster metadata.
**/logs/
**/provenance/

# Full production freezes remain outside Git. Public scientific projections are
# published as versioned release assets; only their small descriptors are tracked.
/results/frozen/*/
!/results/frozen/20260812T035654Z_a0703698ace9/
!/results/frozen/20260812T035654Z_a0703698ace9/**

# LaTeX intermediates; keep source and final PDFs.
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
/paper/current_state/source/build/
/paper/current_state/source/main.pdf
